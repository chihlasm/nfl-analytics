# Copy to .env and adjust. Every value has a sensible default; only change what you need.

# Where the Parquet cache, the database and status.json live (inside the container).
NFL_DATA_DIR=/data

# First season to load. 1999 is the earliest nflverse play-by-play season.
NFL_FIRST_SEASON=1999

# Leave blank to detect automatically (the season "year" flips over in August).
NFL_CURRENT_SEASON=

# Schedules (cron syntax, evaluated in NFL_TIMEZONE).
#   Checks: look for new current-season files; rebuild only if something changed
#   (a check that finds nothing takes about 2 seconds). Blank = every 15 minutes on
#   game days from noon to 3 AM, hourly otherwise. Separate several with ";".
#   NFL_DAILY_CRON, if set, is one more check time (kept for older .env files).
#   Weekly full refresh: re-download every season to pick up nflverse corrections.
NFL_TIMEZONE=America/New_York
NFL_CHECK_CRONS=
NFL_DAILY_CRON=0 6 * * *
NFL_FULL_REFRESH_CRON=30 6 * * 3

# Live scores while games are on (ESPN's public scoreboard, polled every 30 s
# during games). Unofficial: if it fails, scores fall back to nflverse's.
# Leave blank for the default; set to "off" to turn live scores off.
NFL_LIVE_SCORES_URL=

# Parallel downloads.
NFL_DOWNLOAD_WORKERS=4

# Logging: DEBUG, INFO, WARNING, ERROR
NFL_LOG_LEVEL=INFO

# News headlines for the dashboard: comma-separated "Name|URL" RSS feeds.
# Leave blank for the defaults (ESPN, CBS Sports, Yahoo Sports, Pro Football Talk).
NFL_NEWS_FEEDS=

# The Docker network the homelab's main Caddy is on.
HOMELAB_NETWORK=docker_homelab

# Host side: the user and group IDs the containers run as (match your docker-01 user).
PUID=1000
PGID=1000
