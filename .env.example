# Copy to .env and adjust. Every value has a sensible default; only change what you need.

# Where the Parquet cache, the database and status.json live (inside the container).
NFL_DATA_DIR=/data

# First season to load. 1999 is the earliest nflverse play-by-play season.
NFL_FIRST_SEASON=1999

# Leave blank to detect automatically (the season "year" flips over in August).
NFL_CURRENT_SEASON=

# Schedules (cron syntax, evaluated in NFL_TIMEZONE).
#   Daily refresh: re-download current-season files, rebuild the database.
#   Weekly full refresh: re-download every season to pick up nflverse corrections.
NFL_TIMEZONE=America/New_York
NFL_DAILY_CRON=0 6 * * *
NFL_FULL_REFRESH_CRON=30 6 * * 3

# Parallel downloads.
NFL_DOWNLOAD_WORKERS=4

# Logging: DEBUG, INFO, WARNING, ERROR
NFL_LOG_LEVEL=INFO

# Host side: the user and group IDs the container runs as (match your docker-01 user).
PUID=1000
PGID=1000
